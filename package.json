        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.44",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.0"
